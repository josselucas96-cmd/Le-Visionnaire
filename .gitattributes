# Line-ending policy: normalize text files to LF in the repo, render with
# native EOL on checkout. Prevents the CRLF↔LF churn that turns Windows-only
# diffs into 4000-line phantom diffs (incident pre-2026-06-09).

* text=auto eol=lf

# Explicit text types (avoid binary heuristic edge cases)
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.csv   text eol=lf

# Binaries — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.xlsx   binary
*.docx   binary
*.pptx   binary
*.zip    binary
*.gz     binary
